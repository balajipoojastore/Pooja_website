{
  "name": "the-pooja-house",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:customer",
    "dev:customer": "npm run dev --workspace @pooja-house/customer",
    "dev:admin": "npm run dev --workspace @pooja-house/admin",
    "build": "npm run build:customer && npm run build:admin",
    "build:customer": "npm run build --workspace @pooja-house/customer",
    "verify:customer-deploy": "npm run lint && npm run typecheck --workspace @pooja-house/customer && npm run test:customer && npm run build:customer && npm run security:scan:customer",
    "build:admin": "npm run build --workspace @pooja-house/admin",
    "skeletons:customer": "npm run skeletons:build --workspace @pooja-house/customer",
    "test": "npm run test:customer && npm run test:admin && npm run test:server",
    "test:customer": "npm run test --workspace @pooja-house/customer",
    "test:admin": "npm run test --workspace @pooja-house/admin",
    "test:server": "vitest run supabase/functions scripts",
    "test:e2e": "playwright test",
    "test:e2e:customer": "playwright test --project=customer",
    "test:e2e:admin": "playwright test --project=admin",
    "test:e2e:real-order": "playwright test e2e/real-order.e2e.ts --project=customer",
    "security:scan": "node scripts/scan-browser-bundles.mjs",
    "security:scan:customer": "node scripts/scan-browser-bundles.mjs apps/customer/dist",
    "invoice:preview": "tsx scripts/generate-invoice-preview.ts",
    "typecheck": "tsc -p tsconfig.node.json --pretty false && npm run typecheck --workspaces --if-present",
    "lint": "eslint apps packages scripts --max-warnings 0",
    "catalog:validate": "node --env-file-if-exists=.env --import tsx scripts/import-catalog.ts validate",
    "catalog:import": "node --env-file-if-exists=.env --import tsx scripts/import-catalog.ts import"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "exceljs": "^4.4.0",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "pdf-lib": "^1.17.1",
    "postcss": "^8.4.49",
    "sharp": "^0.35.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.18.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
